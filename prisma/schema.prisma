generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      String    @id @default(cuid())
  email                   String    @unique
  name                    String?
  timezone                String    @default("America/Los_Angeles")
  phoneE164               String?   @unique
  smsConsent              Boolean   @default(false)
  quietHours              Json?
  dailyMsgCount           Int       @default(0)
  lastMsgDate             DateTime?
  calendarAccessToken     String?
  calendarRefreshToken    String?
  calendarConnectedAt     DateTime?
  calendarSyncedAt        DateTime?
  calendarSyncedMeds      Boolean   @default(false)
  stripeCustomerId        String?   @unique
  subscriptionId          String?
  subscriptionStatus      String    @default("none")
  subscriptionPeriodEnd   DateTime?
  cardLast4               String?
  freeAccess              Boolean   @default(false)
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  cycles            Cycle[]
  uploads           Upload[]
  checkIns          CheckIn[]
  messages          MessageLog[]
  chatMessages      ChatMessage[]
  convoStates       ConversationState[]
  pushSubscriptions PushSubscription[]
}

model Cycle {
  id        String   @id @default(cuid())
  userId    String
  status    String   @default("ACTIVE")
  startDate DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User               @relation(fields: [userId], references: [id])
  protocol     ProtocolPlan?
  planDays     PlanDay[]
  tasks        Task[]
  checkIns     CheckIn[]
  chatMessages ChatMessage[]
  convoState   ConversationState?
}

model Upload {
  id            String   @id @default(cuid())
  userId        String
  cycleId       String?
  kind          String
  storageKey    String
  mimeType      String
  status        String   @default("UPLOADED")
  extractedText String?
  fileData      Bytes?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model ProtocolPlan {
  id             String   @id @default(cuid())
  cycleId        String   @unique
  status         String   @default("DRAFT")
  source         String
  cycleStartDate DateTime
  notes          String?
  rawDocumentUrl String?
  structuredData Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  cycle        Cycle         @relation(fields: [cycleId], references: [id])
  medications  Medication[]
  appointments Appointment[]
  milestones   Milestone[]
}

model Medication {
  id             String    @id @default(cuid())
  protocolPlanId String
  name           String
  dosageAmount   Float?
  dosageUnit     String?
  unitStrength   String?
  dosage         String?
  frequency      String    @default("once_daily")
  route          String?
  startDate      DateTime?
  endDate        DateTime?
  startDayOffset Int
  durationDays   Int
  timeOfDay      String?
  exactTime      String?
  doses          Json?
  instructions   String?

  protocolPlan ProtocolPlan @relation(fields: [protocolPlanId], references: [id], onDelete: Cascade)
}

model Appointment {
  id             String    @id @default(cuid())
  protocolPlanId String
  type           String
  date           DateTime?
  dayOffset      Int
  exactTime      String?
  duration       Int?
  location       String?
  notes          String?
  fasting        Boolean   @default(false)
  critical       Boolean   @default(false)

  protocolPlan ProtocolPlan @relation(fields: [protocolPlanId], references: [id], onDelete: Cascade)
}

model Milestone {
  id             String  @id @default(cuid())
  protocolPlanId String
  type           String
  dayOffset      Int
  label          String?
  details        String?

  protocolPlan ProtocolPlan @relation(fields: [protocolPlanId], references: [id], onDelete: Cascade)
}

model PlanDay {
  id            String   @id @default(cuid())
  cycleId       String
  date          DateTime
  cycleDayIndex Int
  title         String
  summary       String?
  createdAt     DateTime @default(now())

  cycle Cycle  @relation(fields: [cycleId], references: [id])
  tasks Task[]
}

model Task {
  id               String    @id @default(cuid())
  cycleId          String
  planDayId        String?
  kind             String
  label            String
  dueAt            DateTime?
  timeWindow       Json?
  status           String    @default("PENDING")
  meta             Json?
  displayInUpcoming Boolean  @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  cycle   Cycle    @relation(fields: [cycleId], references: [id])
  planDay PlanDay? @relation(fields: [planDayId], references: [id])
}

model CheckIn {
  id        String   @id @default(cuid())
  userId    String
  cycleId   String
  mood      Int?
  symptoms  String[]
  note      String?
  source    String   @default("SMS")
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id])
  cycle Cycle @relation(fields: [cycleId], references: [id])
}

model MessageLog {
  id                String   @id @default(cuid())
  userId            String
  direction         String
  channel           String   @default("SMS")
  toNumber          String?
  fromNumber        String?
  body              String
  providerMessageId String?
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model ConversationState {
  id        String   @id @default(cuid())
  userId    String
  cycleId   String   @unique
  summary   String   @default("")
  updatedAt DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id])
  cycle Cycle @relation(fields: [cycleId], references: [id])
}

model ChatMessage {
  id        String   @id @default(cuid())
  userId    String
  cycleId   String
  sender    String   // SYSTEM, USER, BUDDY
  type      String   // REMINDER, CHECKIN, APPOINTMENT, INFO, MESSAGE
  content   String
  meta      Json?    // Extra data (medicationId, appointmentId, mood, etc.)
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id])
  cycle Cycle @relation(fields: [cycleId], references: [id])

  @@index([userId, cycleId, createdAt])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ============= INSIGHT TABLES =============
// These tables support AI chat optimization without affecting core protocol logic

model Insight_UserSuggestion {
  id           String   @id @default(cuid())
  userId       String
  cycleId      String
  suggestionId String
  wasHelpful   Boolean?
  dismissed    Boolean  @default(false)
  shownAt      DateTime @default(now())
  respondedAt  DateTime?

  @@index([userId, cycleId])
  @@index([suggestionId])
}

model Insight_UserMemory {
  id        String   @id @default(cuid())
  userId    String
  category  String   // preference, fact, whatHelped, trigger
  content   String
  source    String   // chat, checkin, explicit
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, category])
}

model Insight_DailyMood {
  id           String   @id @default(cuid())
  userId       String
  cycleId      String
  date         DateTime
  cycleDayIndex Int
  avgMood      Float?
  symptoms     String[]
  injectionCount Int    @default(0)
  notes        String?
  createdAt    DateTime @default(now())

  @@unique([userId, cycleId, date])
  @@index([userId, cycleId])
}

model Insight_CycleSummary {
  id               String   @id @default(cuid())
  userId           String
  cycleId          String   @unique
  totalDays        Int
  avgMood          Float?
  commonSymptoms   String[]
  whatHelped       String[]
  whatDidntHelp    String[]
  injectionTotal   Int      @default(0)
  completedAt      DateTime?
  createdAt        DateTime @default(now())

  @@index([userId])
}

model Insight_ProactiveCheckIn {
  id           String   @id @default(cuid())
  userId       String
  cycleId      String
  eventType    String   // trigger, retrieval, transfer, beta
  scheduledFor DateTime
  sent         Boolean  @default(false)
  sentAt       DateTime?
  displayInUI  Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([userId, cycleId])
  @@index([scheduledFor, sent])
}

// ============= SAFETY AUDIT LOG =============
// Logs all Tier 2+ safety classifications for review and liability protection

model SafetyAuditLog {
  id            String   @id @default(cuid())
  userId        String
  cycleId       String?
  tier          Int      // 0, 1, 2, 3
  category      String   // normal, positive, elevated, mental_health, medical, crisis
  triggerPhrase String?  // What triggered the classification
  source        String   // hard_coded or llm
  userMessage   String   @db.Text
  responseText  String   @db.Text
  createdAt     DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
  @@index([tier])
}
